{
  "name": "stellargive",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "dotenv": "^18.0.6",
    "husky": "^9.0.11",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "frontend/node_modules/.bin/eslint --config frontend/eslint.config.mjs --fix"
    ],
    "contracts/**/*.rs": [
      "cargo fmt --manifest-path contracts/stellar-give/Cargo.toml --"
    ]
  }
}
